diff --git a/zathura/utils.c b/zathura/utils.c
index 376d8d8..0bfa98d 100644
--- a/zathura/utils.c
+++ b/zathura/utils.c
@@ -732,3 +732,60 @@ bool search_document(zathura_t* zathura, girara_argument_t* argument, bool disab
 
   return false;
 }
+
+char* zathura_hint_chars(zathura_t* zathura) {
+  char* chars = NULL;
+  girara_setting_get(zathura->ui.session, "hint-chars", &chars);
+  if (chars == NULL || strlen(chars) < 2) {
+    g_free(chars);
+    chars = g_strdup("asdfghjkl");
+  }
+  return chars;
+}
+
+unsigned int zathura_hint_length(zathura_t* zathura) {
+  const unsigned int count = zathura->ui.link_hints;
+  if (count == 0) {
+    return 0;
+  }
+
+  g_autofree char* chars = zathura_hint_chars(zathura);
+  const unsigned int base = strlen(chars);
+  unsigned int length     = 1;
+  for (unsigned long labels = base; labels < count; labels *= base) {
+    length++;
+  }
+  return length;
+}
+
+char* zathura_hint_label(zathura_t* zathura, unsigned int index) {
+  g_autofree char* chars    = zathura_hint_chars(zathura);
+  const unsigned int base   = strlen(chars);
+  const unsigned int length = MAX(zathura_hint_length(zathura), 1);
+
+  char* label = g_malloc0(length + 1);
+  for (unsigned int i = length; i > 0; i--) {
+    label[i - 1] = chars[index % base];
+    index /= base;
+  }
+  return label;
+}
+
+int zathura_hint_index(zathura_t* zathura, const char* input) {
+  const unsigned int length = zathura_hint_length(zathura);
+  if (input == NULL || length == 0 || strlen(input) != length) {
+    return -1;
+  }
+
+  g_autofree char* chars  = zathura_hint_chars(zathura);
+  const unsigned int base = strlen(chars);
+  unsigned long index     = 0;
+  for (const char* c = input; *c != '\0'; c++) {
+    const char* digit = strchr(chars, g_ascii_tolower(*c));
+    if (digit == NULL) {
+      return -1;
+    }
+    index = index * base + (digit - chars);
+  }
+  return index < zathura->ui.link_hints ? (int)index : -1;
+}

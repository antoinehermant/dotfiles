collections = ["from a"]
conflict_resolution = "a wins"

[storage outlook_infomaniak_calendar_remote]
type = "caldav"
url.fetch = ["command", "sed", "-n", "s|^outlook_infomaniak_calendar=||p", "/home/anthe/.secrets/dav"]
username.fetch = ["command", "sed", "-n", "s|^infomaniak_user=||p", "/home/anthe/.secrets/dav"]

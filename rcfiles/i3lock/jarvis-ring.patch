+/* --jarvis: one pixmap kept, drawn whole at first, when the screens change and
+ * every 30 seconds (the date), else only the rings' squares */
+static void jarvis_redraw(void) {
+    static xcb_pixmap_t pixmap = XCB_NONE;
+    static uint32_t width = 0, height = 0;
+    static double last_full = 0;
+    double now = jarvis_now();
+    bool full = pixmap == XCB_NONE || width != last_resolution[0] || height != last_resolution[1] ||
+                jarvis_box_count == 0 || now - last_full > 30;
+    if (full) {
+        if (pixmap != XCB_NONE)
+            xcb_free_pixmap(conn, pixmap);
+        pixmap = create_bg_pixmap(conn, win, last_resolution, color);
+        width = last_resolution[0];
+        height = last_resolution[1];
+        last_full = now;
+    }
+    jarvis_clip = !full;
+    render_lock(last_resolution, pixmap);
+    if (full) {
+        xcb_change_window_attributes(conn, win, XCB_CW_BACK_PIXMAP, (uint32_t[1]){pixmap});
+        xcb_clear_area(conn, 0, win, 0, 0, width, height);
+    } else {
+        for (int i = 0; i < jarvis_box_count; i++)
+            xcb_clear_area(conn, 0, win, fmax(0, jarvis_boxes[i].x), fmax(0, jarvis_boxes[i].y),
+                           ceil(jarvis_boxes[i].size) + 1, ceil(jarvis_boxes[i].size) + 1);
+    }
+    /* The boxes for the next frame */
+    memcpy(jarvis_boxes, jarvis_drawn, sizeof jarvis_drawn);
+    jarvis_box_count = jarvis_drawn_count;
+    xcb_flush(conn);
+}

+/* The background for --jarvis, drawn again only if the screens change */
+static void jarvis_background(uint32_t *resolution, cairo_surface_t *like) {
+    static uint32_t width = 0, height = 0;
+    if (jarvis_bg && width == resolution[0] && height == resolution[1])

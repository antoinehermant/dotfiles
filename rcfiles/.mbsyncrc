# ------------------- Infomaniak --------------------------------------------------------------------------------------------------
IMAPAccount infomaniak
Host mail.infomaniak.com
Port 993
User antoine.hermant@etik.com
PassCmd "gpg -q --no-tty -d ~/.secrets/mbsync-infomaniak.gpg"
TLSType IMAPS
TLSVersions +1.2
CertificateFile /etc/ssl/certs/ca-certificates.crt

IMAPStore infomaniak-remote
Account infomaniak

MaildirStore infomaniak-local
Path ~/documents/mail/Infomaniak/
Inbox ~/documents/mail/Infomaniak/INBOX/
SubFolders Verbatim

# With mbsync 1.4.0 and later: Use 'Far' instead of 'Master', and
# 'Near' instead of 'Slave'.
Channel infomaniak
Far :infomaniak-remote:
Near :infomaniak-local:
Patterns *
Expunge Both
CopyArrivalDate yes
Sync All
Create Both
SyncState *


# ------------------- AntADatabase --------------------------------------------------------------------------------------------------
IMAPAccount antadatabase
Host mail.infomaniak.com
Port 993
User contact@antadatabase.com
PassCmd "gpg -q --no-tty -d ~/.secrets/mbsync-antadatabase.gpg"
TLSType IMAPS
TLSVersions +1.2
CertificateFile /etc/ssl/certs/ca-certificates.crt

IMAPStore antadatabase-remote
Account antadatabase

MaildirStore antadatabase-local
Path ~/documents/mail/AntADatabase/
Inbox ~/documents/mail/AntADatabase/INBOX/
SubFolders Verbatim

Channel antadatabase
Far :antadatabase-remote:
Near :antadatabase-local:
Patterns *
Expunge Both
CopyArrivalDate yes
Sync All
Create Both
SyncState *

# UNIBE -------------------------------------------------
# Microsoft 365 only takes OAuth2: ms365-token signs in the way
# Thunderbird does and prints a fresh token (needs the XOAUTH2 SASL
# plugin, libsasl2-modules-kdexoauth2)
IMAPAccount unibe
Host outlook.office365.com
Port 993
User antoine.hermant@unibe.ch
PassCmd "ms365-token"
AuthMechs XOAUTH2
TLSType IMAPS
TLSVersions +1.2
CertificateFile /etc/ssl/certs/ca-certificates.crt

IMAPStore unibe-remote
Account unibe

MaildirStore unibe-local
Path ~/documents/mail/UniBe/
Inbox ~/documents/mail/UniBe/INBOX/
SubFolders Verbatim

# Leave out the calendar, contacts and other Outlook-only folders
Channel unibe
Far :unibe-remote:
Near :unibe-local:
Patterns * !Calendar* !Contacts* "!Conversation History" !Journal !Notes !Outbox !Tasks !Trash
Expunge Both
CopyArrivalDate yes
Sync All
Create Both
SyncState *

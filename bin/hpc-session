#!/bin/bash -l
# On UBELIX: my work session, in tmux (rcfiles/tmux-hpc.conf), which stays
# when I disconnect. `hpc` (on the laptop, or on UBELIX) runs this.
#   hpc           attach to the session if it runs; else start it
#   hpc restart   end the session (its Emacs too) and start a fresh one
#   hpc stop      end the session
# It starts with:
# - the modules loaded once (HPC_MODULES), so all its shells have them;
# - Neovim's plugins, parsers and servers unpacked to the login node's
#   local disk (bin/nvim-plugins, $NVIM_LOCAL);
# - Emacs, always on in the second tab (`ehpc`, bash/.bash_hpc): an ordinary
#   Emacs in the terminal, not a daemon, which UBELIX kills on its login
#   nodes. Its slow first start (up to a minute, the home's storage cold)
#   happens while I do something else; `et` and `eg` open it at once;
# - Neovim in the third tab.
# The session lives on this login node: ~/.ssh/config pins ubelix3 to submit03.
SESSION=hpc
HPC_MODULES="nctools CMake/3.26.3 GCC/12.3.0 nodejs/18.17.1-GCCcore-12.3.0"

case "${1:-}" in
    restart|stop)
        if [ "$1" = restart ] && [ -n "${TMUX:-}" ]; then
            echo "hpc-session: from outside tmux: C-b d, then hpc restart"
            exit 1
        fi
        if tmux has-session -t "$SESSION" 2>/dev/null; then
            read -r -p "End the session $SESSION, its Emacs and shells? [y/N] " answer
            [ "$answer" = y ] || exit 1
            tmux kill-session -t "$SESSION"
        fi
        [ "$1" = stop ] && exit 0
        ;;
    "") ;;
    *) sed -n '2,6s/^# \{0,1\}//p' "$0"; exit 1 ;;
esac

if [ -n "${TMUX:-}" ]; then
    echo "hpc-session: already in tmux (C-b d to detach)"
    exit 0
fi
# Attached, in a vterm of my laptop's Emacs (emacs/modules/anthe-vterm.el):
# the buffer is UBELIX and every key comes here; detached, evil again.
# Other terminals ignore the sequence.
attach() {
    printf '\e]51;Eanthe/vterm-hpc "on"\e\\'
    tmux attach -t "$SESSION"
    printf '\e]51;Eanthe/vterm-hpc "off"\e\\'
}

if tmux has-session -t "$SESSION" 2>/dev/null; then
    attach
    exit
fi

# The group's modules (nctools), which only interactive shells get
for dir in /storage/workspaces/climate_charibdis/climate_ism/Software/epyc2.9/modulefiles/all \
           /storage/workspaces/climate_charibdis/climate_ism/modulefiles; do
    [ -d "$dir" ] && module use "$dir"
done
module load $HPC_MODULES >/dev/null 2>&1 || echo "hpc-session: not all of $HPC_MODULES loaded"
export NVIM_LOCAL=/tmp/$USER/nvim COLORTERM=truecolor
"$HOME/.dotfiles/bin/nvim-plugins" unpack || echo "hpc-session: Neovim's plugins not unpacked"
cd /storage/workspaces/climate_charibdis/climate_ism/hermant 2>/dev/null || cd

tmux -f "$HOME/.dotfiles/rcfiles/tmux-hpc.conf" new-session -d -s "$SESSION" -n main
# Emacs in the second tab, in a shell that stays when I quit it (ehpc again)
tmux new-window -d -t "$SESSION" -n emacs
tmux send-keys -t "$SESSION:emacs" ehpc Enter
# Neovim in the third, quicker to start
tmux new-window -d -t "$SESSION" -n nvim
tmux send-keys -t "$SESSION:nvim" nvim Enter
attach

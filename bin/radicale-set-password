#!/bin/bash
# Set the password of the Radicale user on the Pi.
# The password is typed here, stored encrypted for vdirsyncer in
# ~/.secrets/dav-radicale.gpg, and its bcrypt hash written to
# /etc/radicale/users on the Pi. It is never put on a command line.
set -euo pipefail

user=${1:-anthe}
host=piv
key=3775D8ADB2DD06E6
secret=~/.secrets/dav-radicale.gpg
url=http://10.158.145.1:5232/$user/

read -rsp "Radicale password for $user: " password; echo
read -rsp "Again: " again; echo
[ "$password" = "$again" ] || { echo "The passwords differ." >&2; exit 1; }
[ -n "$password" ] || { echo "Empty password." >&2; exit 1; }

printf '%s' "$password" | gpg -q --batch --yes -e -r "$key" -o "$secret"
chmod 600 "$secret"
echo "Saved encrypted in $secret"

printf '%s\n' "$password" | ssh "$host" "sudo htpasswd -B -i /etc/radicale/users '$user'"

# Check the login, passing the password to curl on stdin (curl's config
# syntax needs \ and " escaped)
escaped=${password//\\/\\\\}; escaped=${escaped//\"/\\\"}
code=$(printf 'user = "%s:%s"\n' "$user" "$escaped" |
       curl -s -K - -o /dev/null -w '%{http_code}' -X PROPFIND -H 'Depth: 0' "$url")
if [ "$code" = 207 ]; then
    echo "Login works ($url)"
else
    echo "Login failed: HTTP $code" >&2; exit 1
fi

# shellcheck shell=bash
# UBELIX only, sourced by its ~/.bashrc: Emacs (the conda one, Doom),
# Neovim, and the tmux session's X display.

# Conda's base, written out: `conda info --base` takes 20 s here
CONDA_BASE=/storage/workspaces/climate_charibdis/climate_ism/Software/miniconda

# Emacs runs without the modules' libraries (they clash with conda's); the
# programs it starts (ncview, vterm's shells) get them back from
# MODULES_LD_LIBRARY_PATH (emacs/config-hpc.el)
_emc_run() {
    ml poppler/23.09.0 SQLite/3.42.0 ImageMagick/7.1.1-15 nctools >/dev/null 2>&1
    local env="$CONDA_BASE/envs/emacs"
    env -u LD_LIBRARY_PATH MODULES_LD_LIBRARY_PATH="$LD_LIBRARY_PATH" PATH="$env/bin:$PATH" \
        DOOMLOCALDIR="$HOME/.local/share/doom-emacs31/" "$@"
}
emc()   { _emc_run "$CONDA_BASE/envs/emacs/bin/emacs" "$@"; }
doomc() { _emc_run "$HOME/.config/emacs/bin/doom" "$@"; }

# My Emacs, always on in the session's second tab (bin/hpc-session): an
# ordinary Emacs in the terminal, not a daemon (UBELIX kills those on its
# login nodes), whose server "hpc" et and eg open: et in this terminal, eg
# in a window (X forwarding; close those before disconnecting, as GTK's
# Emacs may crash when its X connection goes).
ehpc() {
    _emc_run "$CONDA_BASE/envs/emacs/bin/emacs" -nw \
        --eval '(progn (require (quote server)) (setq server-name "hpc") (server-start))' "$@"
}
_ehpc_client() {
    _emc_run "$CONDA_BASE/envs/emacs/bin/emacsclient" -s hpc "$@" ||
        echo "No Emacs running: in tmux's second tab, type ehpc (hpc restart starts all again)"
}
et() { _ehpc_client -t "$@"; }
eg() { _ehpc_client -c -n "$@"; }

# Neovim, 0.11 (the system's is 0.8), in any shell from the login node's
# local disk (bin/nvim-plugins): unpacked first if it isn't yet
export NVIM_LOCAL=/tmp/$USER/nvim
unalias v nvim 2>/dev/null
nvim() {
    [ -d "$NVIM_LOCAL/lazy" ] || ~/.dotfiles/bin/nvim-plugins unpack
    ~/software/nvim-linux-x86_64/bin/nvim "$@"
}
v() { nvim "$@"; }

# My tmux session (bin/hpc-session): back to it after a plain ssh ubelix3,
# or started if it doesn't run
hpc() { ~/.dotfiles/bin/hpc-session "$@"; }

# In tmux, a shell started before the last connection keeps its X display:
# read the session's again at each prompt, for ncview
if [ -n "$TMUX" ]; then
    _hpc_display() {
        local line
        line=$(tmux show-environment DISPLAY 2>/dev/null) && [ "${line#DISPLAY=}" != "$line" ] && export "$line"
    }
    PROMPT_COMMAND="_hpc_display${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
fi
